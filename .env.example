# OpenAI (required for tutor chat / exam-mode AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Password reset email — SendGrid: https://sendgrid.com (free tier)
# Left blank, forgot-password still works in dev: the reset link is logged
# to the server console instead of emailed.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com

# Used to build the link inside the password-reset email
FRONTEND_BASE_URL=http://localhost:5173

# Comma-separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Error tracking — Sentry: https://sentry.io (free tier)
# Left blank, the app behaves exactly as without Sentry.
SENTRY_DSN=
